<div
  id="cookie-banner"
  class="fixed bottom-5 left-1/2 z-[55] hidden w-[min(100%-1.5rem,72rem)] -translate-x-1/2 rounded-[1.5rem] border border-champagne/18 bg-[#111111] p-4 shadow-2xl md:p-5"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p class="max-w-3xl text-sm leading-7 text-white/72">
      We use analytics cookies to understand which pages and calls to action are most helpful. You
      can accept or dismiss this banner at any time.
    </p>
    <div class="flex gap-3">
      <button class="rounded-xl border border-white/10 px-4 py-3 text-sm text-white/70" data-cookie-dismiss>
        Dismiss
      </button>
      <button class="button-gold rounded-xl px-5 py-3 text-[0.72rem]" data-cookie-accept>
        Accept Cookies
      </button>
    </div>
  </div>
</div>

<script>
  const banner = document.getElementById("cookie-banner");
  const cookieKey = "ramirez-cookie-consent";

  if (banner && !localStorage.getItem(cookieKey)) {
    banner.classList.remove("hidden");
  }

  document.querySelectorAll("[data-cookie-dismiss], [data-cookie-accept]").forEach((button) => {
    button.addEventListener("click", () => {
      localStorage.setItem(cookieKey, button.hasAttribute("data-cookie-accept") ? "accepted" : "dismissed");
      banner?.classList.add("hidden");
    });
  });
</script>
