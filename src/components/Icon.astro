---
type Props = {
  name:
    | "sprout"
    | "glove"
    | "trophy"
    | "shield"
    | "discover"
    | "design"
    | "build"
    | "care"
    | "phone"
    | "mail"
    | "clock";
  class?: string;
};

const { name, class: className = "h-8 w-8" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === "sprout" && (
      <>
        <path d="M12 19v-9" />
        <path d="M12 11c0-3.2 2.6-5.8 5.8-5.8 0 3.2-2.6 5.8-5.8 5.8Z" />
        <path d="M12 13.5c0-2.8-2.2-5-5-5 0 2.8 2.2 5 5 5Z" />
        <path d="M8 19h8" />
      </>
    )
  }
  {
    name === "glove" && (
      <>
        <path d="M6.5 12.5V7.4a1.1 1.1 0 0 1 2.2 0V11" />
        <path d="M8.7 11V6.2a1.1 1.1 0 0 1 2.2 0v4.4" />
        <path d="M10.9 10.6V5.8a1.1 1.1 0 0 1 2.2 0v4.8" />
        <path d="M13.1 10.9V7.1a1.1 1.1 0 0 1 2.2 0v7.2l1-1a1.3 1.3 0 0 1 1.8 1.8l-3.6 3.6a3 3 0 0 1-2.1.9H10a3 3 0 0 1-3-3Z" />
      </>
    )
  }
  {
    name === "trophy" && (
      <>
        <path d="M8 4h8v3a4 4 0 0 1-4 4 4 4 0 0 1-4-4V4Z" />
        <path d="M6 5H4a2 2 0 0 0 2 2" />
        <path d="M18 5h2a2 2 0 0 1-2 2" />
        <path d="M12 11v3" />
        <path d="M9 20h6" />
        <path d="M10 14h4l1 6H9l1-6Z" />
      </>
    )
  }
  {
    name === "shield" && (
      <>
        <path d="M12 3 6 5.5v5.2c0 4 2.5 7.7 6 9.3 3.5-1.6 6-5.3 6-9.3V5.5L12 3Z" />
        <path d="m9.5 11.8 1.8 1.8 3.2-3.6" />
      </>
    )
  }
  {
    name === "discover" && (
      <>
        <path d="M12 19v-8" />
        <path d="M12 11c0-3.3 2.7-6 6-6 0 3.3-2.7 6-6 6Z" />
        <path d="M12 14c0-2.8-2.2-5-5-5 0 2.8 2.2 5 5 5Z" />
      </>
    )
  }
  {
    name === "design" && (
      <>
        <path d="M4 18h16" />
        <path d="M7 18V6h10v12" />
        <path d="M9 9h6" />
        <path d="M9 12h6" />
        <path d="M11 6V4" />
        <path d="M13 6V4" />
      </>
    )
  }
  {
    name === "build" && (
      <>
        <path d="m14 4 6 6" />
        <path d="m13 7 4 4" />
        <path d="m4 20 7-7" />
        <path d="m3 17 4 4" />
        <path d="m10 6 8 8" />
      </>
    )
  }
  {
    name === "care" && (
      <>
        <path d="M12 19v-8" />
        <path d="M12 11c0-3.2 2.6-5.8 5.8-5.8 0 3.2-2.6 5.8-5.8 5.8Z" />
        <path d="M12 11c0-3.2-2.6-5.8-5.8-5.8 0 3.2 2.6 5.8 5.8 5.8Z" />
        <path d="M8 19h8" />
      </>
    )
  }
  {
    name === "phone" && (
      <>
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 11.2 19a19.3 19.3 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.4 2.8a2 2 0 0 1-.6 1.8l-2 2a16 16 0 0 0 6 6l2-2a2 2 0 0 1 1.8-.6l2.8.4a2 2 0 0 1 1.7 2Z" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m4 7 8 6 8-6" />
      </>
    )
  }
  {
    name === "clock" && (
      <>
