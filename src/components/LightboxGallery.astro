---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  images: ImageMetadata[];
  columns?: number;
};

const { images, columns = 4 } = Astro.props;
---

<div class:list={["grid gap-4", columns === 3 ? "md:grid-cols-3" : "md:grid-cols-2 xl:grid-cols-4"]}>
  {
    images.map((image, index) => (
      <button
        type="button"
        class="group relative block w-full overflow-hidden rounded-[1.3rem]"
        data-lightbox-open
        data-lightbox-index={index}
      >
        <img
          src={image.src}
          alt={`Gallery image ${index + 1}`}
          class="h-56 w-full object-cover transition duration-500 group-hover:scale-105"
          loading="eager"
        />
      </button>
    ))
  }
</div>

<div
  id="lightbox"
  class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/92 p-4"
  aria-hidden="true"
>
  <button
    type="button"
    class="absolute right-6 top-6 rounded-full border border-white/15 px-4 py-2 text-white"
    data-lightbox-close
    aria-label="Close gallery"
  >
    Close
  </button>
  <img src="" alt="" class="max-h-[90vh] max-w-[92vw] rounded-[1.5rem] object-contain" data-lightbox-image />
</div>

<script define:vars={{ images: images.map((image) => image.src) }}>
  const lightbox = document.getElementById("lightbox");
  const lightboxImage = lightbox?.querySelector("[data-lightbox-image]");

  document.querySelectorAll("[data-lightbox-open]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!lightbox || !lightboxImage) return;
      const index = Number(button.getAttribute("data-lightbox-index") || "0");
      lightboxImage.setAttribute("src", images[index]);
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.classList.add("overflow-hidden");
    });
  });

  document.querySelectorAll("[data-lightbox-close]").forEach((button) => {
    button.addEventListener("click", () => {
      lightbox?.classList.add("hidden");
      lightbox?.classList.remove("flex");
      document.body.classList.remove("overflow-hidden");
    });
  });

  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.classList.remove("overflow-hidden");
    }
  });
</script>
