---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  title: string;
  description: string;
  image: ImageMetadata;
  crumbs?: { label: string; href?: string }[];
};

const { title, description, image, crumbs = [] } = Astro.props;
---

<section class="relative overflow-hidden pt-32">
  <div class="relative min-h-[34rem]">
    <Image
      src={image}
      alt={title}
      class="absolute inset-0 h-full w-full object-cover"
      widths={[960, 1280, 1600]}
      format="webp"
    />
    <div class="page-hero-overlay absolute inset-0"></div>
    <div class="container-shell relative z-10 flex min-h-[34rem] items-end pb-16">
      <div class="max-w-3xl">
        {
          crumbs.length > 0 && (
            <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-sm text-white/60">
              {
                crumbs.map((crumb, index) => (
                  <>
                    {index > 0 && <span>/</span>}
                    {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
                  </>
                ))
              }
            </nav>
          )
        }
        <h1 class="font-[var(--font-display)] text-5xl leading-[0.92] text-ivory md:text-7xl">
          {title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/78 md:text-xl">{description}</p>
      </div>
    </div>
  </div>
</section>
