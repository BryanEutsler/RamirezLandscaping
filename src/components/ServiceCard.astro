---
import { Image } from "astro:assets";
import type { Service } from "@/data/content";

type Props = {
  service: Service;
};

const { service } = Astro.props;
---

<article class="group gold-frame overflow-hidden rounded-[1.8rem] bg-midnight">
  <div class="relative h-64 overflow-hidden">
    <Image
      src={service.cardImage}
      alt={service.name}
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
      widths={[480, 720]}
      format="webp"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-transparent"></div>
  </div>
  <div class="p-7">
    <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-champagne/75">
      {service.accent}
    </p>
    <h3 class="mt-3 font-[var(--font-heading)] text-3xl leading-tight text-ivory">{service.name}</h3>
    <p class="mt-4 text-sm leading-7 text-white/68">{service.shortDescription}</p>
    <a href={`/services/${service.slug}`} class="link-arrow mt-6 inline-flex text-sm uppercase tracking-[0.2em] text-champagne">
      Learn More
    </a>
  </div>
</article>
