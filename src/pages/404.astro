---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found | Ramirez Landscaping" description="The page you requested could not be found.">
  <section class="flex min-h-screen items-center justify-center px-6 pt-28">
    <div class="leaf-pattern gold-frame max-w-3xl rounded-[2rem] bg-midnight p-10 text-center md:p-14">
      <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-champagne/78">404</p>
      <h1 class="mt-4 font-[var(--font-display)] text-5xl leading-tight text-ivory md:text-6xl">
        This path has wandered off the garden trail.
      </h1>
      <p class="mt-6 text-base leading-8 text-white/72">
        The page you are looking for may have moved, been renamed, or no longer exists.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
        <a href="/" class="button-gold rounded-xl px-6 py-4 text-[0.78rem]">Return Home</a>
        <a href="/contact" class="button-outline rounded-xl px-6 py-4 text-[0.78rem]">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
