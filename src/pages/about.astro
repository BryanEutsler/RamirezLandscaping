---
import { Image } from "astro:assets";

import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Icon from "@/components/Icon.astro";
import { awards, coreValues, teamMembers } from "@/data/content";
import { siteConfig } from "@/data/site";
import founderPortrait from "@/assets/photos/founder-portrait.png";
import lawnMaintenance from "@/assets/photos/lawn-maintenance.png";

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: `About ${siteConfig.name}`,
  description: "Company story, values, team, and service area for Ramirez Yard Maintenance.",
};
---

<BaseLayout title={`About ${siteConfig.name}`} description="Learn about the local crew behind Ramirez Yard Maintenance." schema={aboutSchema}>
  <PageHero
    title="About Ramirez Yard Maintenance"
    description="A local crew focused on the basic yard work that keeps homes clean, cut, and under control."
    image={lawnMaintenance}
    crumbs={[{ label: "Home", href: "/" }, { label: "About" }]}
  />

  <section class="paper-panel section-pad">
    <div class="container-shell grid gap-12 xl:grid-cols-[0.9fr_1.1fr]">
      <div class="overflow-hidden rounded-lg border border-black/8 bg-white shadow-[0_24px_46px_rgba(0,0,0,0.08)]">
        <Image src={founderPortrait} alt="Carlos Ramirez portrait" class="h-full min-h-[34rem] w-full object-cover" widths={[720, 960]} format="webp" loading="eager" />
      </div>
      <div>
        <SectionHeading
          title="Built for Everyday Yard Care"
          description="Ramirez Yard Maintenance is not a landscape design firm. We focus on mowing, edging, trimming, weeds, leaves, and practical cleanups."
          theme="light"
        />
        <div class="rich-text mt-8 max-w-3xl">
          <p>
            Carlos Ramirez started the company around a simple need: homeowners and property
            managers wanted someone reliable to keep basic yard work from piling up. The work is not
            complicated, but it does need consistency, clean edges, and respect for the property.
          </p>
          <p>
            Today the crew handles weekly routes, biweekly maintenance, one-time overgrown yard
            cleanups, hedge touchups, and green-waste cleanup. We keep estimates clear and recommend
            only the service rhythm the yard actually needs.
          </p>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-2">
          <article class="rounded-lg border border-black/8 bg-white p-6">
            <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-deep-gold">Mission</p>
            <p class="mt-3 text-base leading-8 text-charcoal/85">
              To make basic yard care dependable, straightforward, and easy to schedule.
            </p>
          </article>
          <article class="rounded-lg border border-black/8 bg-white p-6">
            <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-deep-gold">What Sets Us Apart</p>
            <p class="mt-3 text-base leading-8 text-charcoal/85">
              Clear communication, clean finish work, and no pressure to buy services outside basic
              yard maintenance.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Meet the Crew"
        description="A small team handling estimates, scheduling, routine routes, and cleanup visits."
        align="center"
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
          teamMembers.map((member) => (
            <article class="gold-frame overflow-hidden rounded-lg bg-midnight">
              {
                member.image ? (
                  <Image src={member.image} alt={member.name} class="h-72 w-full object-cover" widths={[420, 720]} format="webp" loading="eager" />
                ) : (
                  <div class="flex h-72 items-center justify-center bg-[linear-gradient(180deg,#181818,_#111)]">
                    <span class="font-[var(--font-display)] text-7xl text-champagne">{member.initials}</span>
                  </div>
                )
              }
              <div class="p-6">
                <h2 class="font-[var(--font-heading)] text-3xl text-ivory">{member.name}</h2>
                <p class="mt-2 font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-champagne/75">
                  {member.title}
                </p>
                <p class="mt-4 text-sm leading-7 text-white/68">{member.bio}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="paper-panel section-pad">
    <div class="container-shell grid gap-10 xl:grid-cols-[0.95fr_1.05fr]">
      <div>
        <SectionHeading title="Our Values" description="The standards we use on routine yard visits and one-time cleanups." theme="light" />
        <div class="mt-10 grid gap-4 md:grid-cols-2">
          {
            coreValues.map((value, index) => (
              <article class="rounded-lg border border-black/8 bg-white p-6">
                <div class="text-deep-gold">
                  <Icon name={index % 2 === 0 ? "clock" : "shield"} class="h-8 w-8" />
                </div>
                <h2 class="mt-5 font-[var(--font-heading)] text-3xl text-midnight">{value.title}</h2>
                <p class="mt-3 text-sm leading-7 text-charcoal/78">{value.description}</p>
              </article>
            ))
          }
        </div>
      </div>
      <div class="rounded-lg border border-black/8 bg-[linear-gradient(180deg,#0c3c27,#173d2a)] p-8 text-white shadow-[0_24px_46px_rgba(0,0,0,0.12)]">
        <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-champagne/75">Service Area</p>
        <h2 class="mt-3 font-[var(--font-display)] text-4xl">Santa Barbara and Nearby Routes</h2>
        <p class="mt-4 max-w-xl text-base leading-8 text-white/74">
          We serve regular yard maintenance routes in Santa Barbara and nearby communities based on
          crew availability.
        </p>
        <div class="mt-8 rounded-lg border border-white/10 bg-black/15 p-6">
          <div class="grid gap-3 sm:grid-cols-2">
            {siteConfig.serviceArea.map((area) => <span>{area}</span>)}
          </div>
        </div>
        <div class="mt-8 h-64 overflow-hidden rounded-lg border border-white/10">
          <iframe
            title="Ramirez Yard Maintenance service area map"
            class="h-full w-full border-0 grayscale"
            loading="lazy"
            src="https://www.google.com/maps?q=Santa+Barbara+CA&output=embed"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Quick Trust Signals"
        description="Practical reasons customers call us for basic recurring yard work."
        align="center"
      />
      <div class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        {
          awards.map((award) => (
            <article class="gold-frame flex min-h-32 items-center justify-center rounded-lg bg-white/[0.025] px-5 py-6 text-center">
              <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.2em] text-white/70">{award}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
