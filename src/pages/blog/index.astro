---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import BlogCard from "@/components/BlogCard.astro";
import { articleCategories, blogPosts } from "@/data/content";
import lawnMaintenance from "@/assets/photos/lawn-maintenance.png";

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Ramirez Yard Maintenance Tips",
  description: "Practical articles on mowing, edging, cleanups, weeds, leaves, and routine yard care.",
};
---

<BaseLayout title="Yard Tips | Ramirez Yard Maintenance" description="Practical yard maintenance tips from Ramirez Yard Maintenance." schema={blogSchema}>
  <PageHero
    title="Yard Tips"
    description="Practical guidance for mowing schedules, edging, cleanups, weeds, leaves, and overgrown yards."
    image={lawnMaintenance}
    crumbs={[{ label: "Home", href: "/" }, { label: "Yard Tips" }]}
  />

  <section class="paper-panel section-pad">
    <div class="container-shell">
      <div class="flex flex-wrap gap-3">
        {articleCategories.map((category) => <span class="rounded-full border border-black/10 bg-white px-4 py-2 text-sm text-charcoal/75">{category}</span>)}
      </div>
      <div class="mt-10 grid gap-6 xl:grid-cols-[1.2fr_0.8fr_0.8fr]">
        <BlogCard post={blogPosts[0]} featured />
        <BlogCard post={blogPosts[1]} />
        <BlogCard post={blogPosts[2]} />
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <BlogCard post={blogPosts[3]} />
      </div>
    </div>
  </section>
</BaseLayout>
