---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import EstimateForm from "@/components/EstimateForm.astro";
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/data/site";
import heroEstate from "@/assets/photos/hero-estate.png";

const contactSchema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contact Ramirez Landscaping",
    description: "Request a quote and contact Ramirez Landscaping.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [],
  },
];
---

<BaseLayout title="Contact | Ramirez Landscaping" description="Request a free estimate or contact Ramirez Landscaping directly." schema={contactSchema}>
  <PageHero
    title="Let's Build Something Extraordinary"
    description="Share your vision and we will bring it to life with expertise, care, and attention to every detail."
    image={heroEstate}
    crumbs={[{ label: "Home", href: "/" }, { label: "Contact" }]}
  />

  <section class="paper-panel section-pad">
    <div class="container-shell grid gap-8 xl:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-6">
        <article class="rounded-[1.7rem] border border-black/8 bg-white p-7 shadow-[0_18px_36px_rgba(0,0,0,0.06)]">
          <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-deep-gold">Get in Touch</p>
          <div class="mt-6 space-y-5">
            <div class="flex items-start gap-4">
              <div class="rounded-full bg-offwhite p-3 text-deep-gold"><Icon name="phone" class="h-5 w-5" /></div>
              <div>
                <p class="font-[var(--font-heading)] text-2xl text-midnight">Phone</p>
                <a href={`tel:${siteConfig.phone.replace(/[^0-9]/g, "")}`} class="text-charcoal/80">{siteConfig.phone}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="rounded-full bg-offwhite p-3 text-deep-gold"><Icon name="mail" class="h-5 w-5" /></div>
              <div>
                <p class="font-[var(--font-heading)] text-2xl text-midnight">Email</p>
                <a href={`mailto:${siteConfig.email}`} class="text-charcoal/80">{siteConfig.email}</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="rounded-full bg-offwhite p-3 text-deep-gold"><Icon name="clock" class="h-5 w-5" /></div>
              <div>
                <p class="font-[var(--font-heading)] text-2xl text-midnight">Business Hours</p>
                <ul class="space-y-1 text-charcoal/80">
                  {siteConfig.hours.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
          </div>
        </article>
        <div class="overflow-hidden rounded-[1.8rem] border border-black/8 bg-white shadow-[0_18px_36px_rgba(0,0,0,0.06)]">
          <iframe
            title="Service area map"
            class="h-[24rem] w-full border-0"
            loading="lazy"
            src="https://www.google.com/maps?q=Santa+Barbara,+CA&output=embed"
          ></iframe>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <article class="rounded-[1.5rem] border border-black/8 bg-white p-5 text-center shadow-[0_12px_24px_rgba(0,0,0,0.04)]">
            <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-deep-gold">BBB</p>
            <p class="mt-3 font-[var(--font-heading)] text-2xl text-midnight">A+ Rated</p>
          </article>
          <article class="rounded-[1.5rem] border border-black/8 bg-white p-5 text-center shadow-[0_12px_24px_rgba(0,0,0,0.04)]">
            <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-deep-gold">Licensed</p>
            <p class="mt-3 font-[var(--font-heading)] text-2xl text-midnight">Contractor Ready</p>
          </article>
          <article class="rounded-[1.5rem] border border-black/8 bg-white p-5 text-center shadow-[0_12px_24px_rgba(0,0,0,0.04)]">
            <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-deep-gold">Guarantee</p>
            <p class="mt-3 font-[var(--font-heading)] text-2xl text-midnight">Satisfaction Focused</p>
          </article>
        </div>
      </div>
      <div>
        <EstimateForm />
      </div>
    </div>
  </section>
</BaseLayout>
