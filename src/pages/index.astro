---
import { Image } from "astro:assets";

import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import TestimonialCarousel from "@/components/TestimonialCarousel.astro";
import Icon from "@/components/Icon.astro";
import BlogCard from "@/components/BlogCard.astro";
import { blogPosts, projects, services, testimonials, valuePillars } from "@/data/content";
import { siteConfig } from "@/data/site";
import lawnMaintenance from "@/assets/photos/lawn-maintenance.png";
import seasonalPlanting from "@/assets/photos/seasonal-planting.png";

const homeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    name: siteConfig.name,
    image: "/brand/ramirez-logo.png",
    telephone: siteConfig.phone,
    email: siteConfig.email,
    address: {
      "@type": "PostalAddress",
      streetAddress: "1220 Coast Garden Drive",
      addressLocality: "Santa Barbara",
      addressRegion: "CA",
      postalCode: "93108",
      addressCountry: "US",
    },
    areaServed: siteConfig.serviceArea,
    url: Astro.site?.toString() ?? "https://www.ramirezyardmaintenance.com",
    sameAs: siteConfig.social.map((item) => item.href),
  },
];

const featuredServices = services.slice(0, 3);
const featuredProjects = projects.slice(0, 3);
const featuredPosts = blogPosts.slice(0, 3);
---

<BaseLayout
  title="Ramirez Yard Maintenance | Mowing, Edging & Yard Cleanups"
  description="Basic yard maintenance in Santa Barbara and nearby areas: mowing, edging, trimming, weeds, leaves, and one-time cleanups."
  schema={homeSchema}
>
  <section class="relative overflow-hidden bg-[#11150f] pt-28">
    <Image
      src={lawnMaintenance}
      alt="Freshly maintained yard with clean lawn lines"
      class="absolute inset-0 h-full w-full object-cover"
      widths={[960, 1280, 1600, 1920]}
      format="webp"
      priority
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(10,16,10,0.9)_0%,rgba(10,16,10,0.72)_48%,rgba(10,16,10,0.34)_100%)]"></div>
    <div class="container-shell relative z-10 grid min-h-[calc(100vh-7rem)] items-center gap-10 py-14 lg:grid-cols-[1fr_24rem]">
      <div class="max-w-3xl">
        <p class="fade-rise font-[var(--font-label)] text-xs uppercase tracking-[0.28em] text-champagne">
          Basic yard maintenance
        </p>
        <h1 class="hero-reveal mt-5 font-[var(--font-display)] text-5xl leading-[0.95] text-ivory md:text-7xl xl:text-[6.5rem]">
          Mowing, edging, trimming, and cleanups.
        </h1>
        <p class="fade-rise mt-7 max-w-2xl text-lg leading-8 text-white/78 md:text-xl" data-delay="1">
          Simple, reliable yard care for homes, rentals, and small properties. No landscape design,
          no big construction pitch, just the work that keeps your yard looking handled.
        </p>
        <div class="fade-rise mt-9 flex flex-col gap-4 sm:flex-row" data-delay="2">
          <a href="/contact" class="button-gold rounded-lg px-6 py-4 text-center text-[0.78rem]">
            Request a Free Estimate
          </a>
          <a href={`tel:${siteConfig.phone.replaceAll(/[^+\d]/g, "")}`} class="button-outline rounded-lg px-6 py-4 text-center text-[0.78rem]">
            Call {siteConfig.phone}
          </a>
        </div>
      </div>

      <aside class="fade-rise rounded-lg border border-white/12 bg-black/45 p-6 backdrop-blur" data-delay="3">
        <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-champagne/85">
          Common visits
        </p>
        <div class="mt-5 grid gap-3 text-sm leading-6 text-white/78">
          <p>Weekly and biweekly yard maintenance</p>
          <p>One-time overgrown yard cleanups</p>
          <p>Mowing, edging, weeds, leaves, and shrub touchups</p>
        </div>
        <div class="mt-6 border-t border-white/10 pt-5">
          <p class="text-sm text-white/58">Serving Santa Barbara, Goleta, Carpinteria, Montecito, Ventura, and nearby route areas.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-y border-champagne/18 bg-[#0b0f0a]">
    <div class="container-shell grid gap-4 py-8 md:grid-cols-2 xl:grid-cols-4">
      {
        valuePillars.map((pillar) => (
          <article class="rounded-lg border border-white/10 bg-white/[0.03] p-6">
            <div class="text-champagne">
              <Icon name={pillar.icon as "sprout" | "glove" | "shield" | "clock"} class="h-9 w-9" />
            </div>
            <h2 class="mt-5 font-[var(--font-heading)] text-2xl text-ivory">{pillar.title}</h2>
            <p class="mt-3 text-sm leading-7 text-white/66">{pillar.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="paper-panel section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Yard Services"
        description="The everyday work most homeowners actually need: clean lines, controlled growth, and a yard that does not look neglected."
        theme="light"
        align="center"
      />
      <div class="mt-12 grid gap-6 xl:grid-cols-3">
        {featuredServices.map((service) => <ServiceCard service={service} />)}
      </div>
      <div class="mt-10 flex justify-center">
        <a href="/services" class="button-gold rounded-lg px-6 py-4 text-[0.78rem]">View All Services</a>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell grid gap-10 xl:grid-cols-[0.88fr_1.12fr]">
      <div>
        <SectionHeading
          title="A Simple Way to Keep the Yard Caught Up"
          description="Most customers start with a quick estimate, choose weekly or biweekly service, and add cleanup work only when the yard needs it."
        />
        <div class="mt-8 grid gap-4">
          {["Send a few details about the yard.", "Get a clear estimate and schedule window.", "We mow, edge, trim, clean up, and keep the route moving."].map((item, index) => (
            <article class="rounded-lg border border-champagne/18 bg-white/[0.025] p-5">
              <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.22em] text-champagne/80">Step {index + 1}</p>
              <p class="mt-2 text-base leading-7 text-white/74">{item}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="overflow-hidden rounded-lg border border-champagne/20">
        <Image
          src={seasonalPlanting}
          alt="Yard cleanup with trimmed greenery"
          class="h-full min-h-[28rem] w-full object-cover"
          widths={[720, 960]}
          format="webp"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="paper-panel section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Recent Yard Work"
        description="A few examples of routine cuts, cleanups, and small-property maintenance."
        theme="light"
        align="center"
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {featuredProjects.map((project) => <ProjectCard project={project} compact />)}
      </div>
      <div class="mt-10 flex justify-center">
        <a href="/portfolio" class="button-gold rounded-lg px-6 py-4 text-[0.78rem]">
          See More Work
        </a>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <TestimonialCarousel items={testimonials.slice(0, 5)} />
    </div>
  </section>

  <section class="border-y border-champagne/18 bg-[linear-gradient(135deg,#d3b45c_0%,#b9912e_100%)] py-12 text-[#171309]">
    <div class="container-shell flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-[#31250c]/78">
          Free Estimate
        </p>
        <h2 class="mt-4 font-[var(--font-display)] text-4xl leading-tight md:text-5xl">
          Need the yard cleaned up or kept on a schedule?
        </h2>
      </div>
      <a href="/contact" class="inline-flex items-center justify-center rounded-lg bg-forest px-7 py-4 font-[var(--font-label)] text-[0.78rem] uppercase tracking-[0.18em] text-white">
        Request Yard Service
      </a>
    </div>
  </section>

  <section class="paper-panel section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Yard Care Tips"
        description="Short, practical notes for mowing schedules, cleanups, and keeping overgrowth under control."
        theme="light"
        align="center"
      />
      <div class="mt-12 grid gap-6 xl:grid-cols-[1.2fr_0.8fr_0.8fr]">
        <BlogCard post={featuredPosts[0]} featured />
        <BlogCard post={featuredPosts[1]} />
        <BlogCard post={featuredPosts[2]} />
      </div>
    </div>
  </section>
</BaseLayout>
