---
import { Image } from "astro:assets";

import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import BeforeAfterSlider from "@/components/BeforeAfterSlider.astro";
import LightboxGallery from "@/components/LightboxGallery.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import StarRating from "@/components/StarRating.astro";
import { projects, testimonials } from "@/data/content";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const relatedProjects = projects.filter((item) => item.slug !== project.slug).slice(0, 4);
const testimonial = testimonials.find((item) => item.id === project.testimonialId);
const projectSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.clientBrief,
};
---

<BaseLayout title={`${project.title} | Ramirez Yard Maintenance`} description={project.clientBrief} schema={projectSchema}>
  <PageHero
    title={project.title}
    description={project.clientBrief}
    image={project.heroImage}
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Our Work", href: "/portfolio" },
      { label: project.title },
    ]}
  />

  <section class="paper-panel section-pad">
    <div class="container-shell grid gap-10 xl:grid-cols-[0.85fr_1.15fr]">
      <div class="space-y-8">
        <article class="rounded-[1.8rem] border border-black/8 bg-white p-8 shadow-[0_18px_36px_rgba(0,0,0,0.07)]">
          <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-deep-gold">Request</p>
          <p class="mt-4 text-base leading-8 text-charcoal/85">{project.clientBrief}</p>
        </article>
        <article class="rounded-[1.8rem] border border-black/8 bg-white p-8 shadow-[0_18px_36px_rgba(0,0,0,0.07)]">
          <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-deep-gold">Work Completed</p>
          <ul class="mt-5 grid gap-3">
            {project.scope.map((item) => <li class="flex gap-3 text-base leading-8 text-charcoal/85"><span class="mt-3 h-2 w-2 rounded-full bg-deep-gold"></span><span>{item}</span></li>)}
          </ul>
          <p class="mt-6 border-t border-black/8 pt-5 text-sm uppercase tracking-[0.18em] text-charcoal/55">Timeline: {project.timeline}</p>
        </article>
      </div>
      <div>
        <BeforeAfterSlider beforeImage={project.beforeImage} afterImage={project.afterImage} />
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <div class="grid gap-10 xl:grid-cols-[1.1fr_0.9fr]">
        <div>
          <h2 class="font-[var(--font-display)] text-4xl text-ivory md:text-5xl">Work Gallery</h2>
          <div class="mt-8">
            <LightboxGallery images={project.gallery} />
          </div>
        </div>
        <div class="space-y-6">
          <article class="rounded-[1.8rem] border border-champagne/18 bg-midnight p-8">
            <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-champagne/75">Result</p>
            <div class="mt-5 space-y-4 text-base leading-8 text-white/72">
              {project.resultNarrative.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </article>
          {
            testimonial && (
              <article class="rounded-[1.8rem] border border-champagne/18 bg-[linear-gradient(180deg,#143822,#112518)] p-8">
                <StarRating rating={testimonial.rating} />
                <blockquote class="mt-5 font-[var(--font-heading)] text-3xl leading-tight text-ivory">
                  “{testimonial.quote}”
                </blockquote>
                <p class="mt-5 font-[var(--font-label)] text-xs uppercase tracking-[0.22em] text-champagne/80">
                  {testimonial.name} · {testimonial.projectType}
                </p>
              </article>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="paper-panel section-pad">
    <div class="container-shell">
      <h2 class="font-[var(--font-display)] text-4xl text-midnight md:text-5xl">Related Yard Work</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {relatedProjects.map((item) => <ProjectCard project={item} compact />)}
      </div>
    </div>
  </section>
</BaseLayout>
