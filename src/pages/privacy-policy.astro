---
import BaseLayout from "@/layouts/BaseLayout.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Privacy Policy",
};
---

<BaseLayout title="Privacy Policy | Ramirez Landscaping" description="Privacy policy for Ramirez Landscaping." schema={schema}>
  <section class="paper-panel min-h-screen pt-36">
    <div class="container-shell max-w-4xl pb-20">
      <h1 class="font-[var(--font-display)] text-5xl text-midnight">Privacy Policy</h1>
      <div class="rich-text mt-8 rounded-[1.8rem] border border-black/8 bg-white p-8 shadow-[0_20px_36px_rgba(0,0,0,0.06)]">
        <p>
          Ramirez Landscaping respects your privacy and uses the information you submit only to
          respond to inquiries, prepare estimates, and improve site performance.
        </p>
        <p>
          Demo language is provided here until final compliance copy is supplied. Before launch,
          this page should be reviewed for CCPA, cookie disclosure, analytics usage, and any
          third-party form or CRM integrations implemented on the site.
        </p>
        <p>
          To request updates or removal of your submitted information, contact us at
          info@ramirezlandscaping.com.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
