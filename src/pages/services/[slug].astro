---
import { Image } from "astro:assets";

import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Icon from "@/components/Icon.astro";
import LightboxGallery from "@/components/LightboxGallery.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import StarRating from "@/components/StarRating.astro";
import { projects, services, testimonials } from "@/data/content";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const relatedProjects = projects.filter((project) => service.relatedProjectSlugs.includes(project.slug));
const serviceTestimonials = testimonials.filter((testimonial) =>
  service.testimonialIds.includes(testimonial.id),
);
const serviceSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: service.name,
    provider: {
      "@type": "LocalBusiness",
      name: "Ramirez Landscaping",
    },
    description: service.shortDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: service.faq.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];
---

<BaseLayout title={`${service.name} | Ramirez Landscaping`} description={service.shortDescription} schema={serviceSchema}>
  <PageHero
    title={service.name}
    description={service.shortDescription}
    image={service.heroImage}
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/services" },
      { label: service.name },
    ]}
  />

  <section class="paper-panel section-pad">
    <div class="container-shell grid gap-10 xl:grid-cols-[0.95fr_1.05fr]">
      <div>
        <SectionHeading title="Service Overview" description={service.accent} theme="light" />
        <div class="rich-text mt-8">
          {service.overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      <article class="rounded-[1.8rem] border border-black/8 bg-white p-8 shadow-[0_20px_40px_rgba(0,0,0,0.08)]">
        <h2 class="font-[var(--font-display)] text-4xl text-midnight">What's Included</h2>
        <ul class="mt-8 grid gap-4">
          {service.includes.map((item) => <li class="flex gap-3 text-base leading-8 text-charcoal/82"><span class="mt-3 h-2 w-2 shrink-0 rounded-full bg-deep-gold"></span><span>{item}</span></li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Our Process"
        description="A step-by-step approach built around planning, quality control, and long-term success."
        align="center"
      />
      <div class="mt-12 grid gap-6 xl:grid-cols-4">
        {
          service.process.map((step, index) => (
            <article class="gold-frame rounded-[1.6rem] bg-white/[0.025] p-6">
              <div class="flex items-center justify-between">
                <span class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-champagne/75">Step {index + 1}</span>
                <div class="text-champagne">
                  <Icon name={step.icon} class="h-8 w-8" />
                </div>
              </div>
              <h2 class="mt-5 font-[var(--font-heading)] text-3xl text-ivory">{step.title}</h2>
              <p class="mt-3 text-sm leading-7 text-white/68">{step.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="paper-panel section-pad">
    <div class="container-shell">
      <SectionHeading title="Project Gallery" description="Demo gallery imagery ready to be replaced with client-supplied project photography." theme="light" align="center" />
      <div class="mt-12">
        <LightboxGallery images={service.gallery} />
      </div>
    </div>
  </section>

  {
    serviceTestimonials[0] && (
      <section class="section-pad">
        <div class="container-shell">
          <article class="rounded-[1.8rem] border border-champagne/18 bg-[linear-gradient(180deg,#173d2a,#102919)] p-8 md:p-10">
            <StarRating rating={serviceTestimonials[0].rating} />
            <blockquote class="mt-6 max-w-4xl font-[var(--font-heading)] text-3xl leading-tight text-ivory md:text-4xl">
              “{serviceTestimonials[0].quote}”
            </blockquote>
            <p class="mt-5 font-[var(--font-label)] text-xs uppercase tracking-[0.22em] text-champagne/80">
              {serviceTestimonials[0].name} · {serviceTestimonials[0].projectType}
            </p>
          </article>
        </div>
      </section>
    )
  }

  <section class="paper-panel section-pad">
    <div class="container-shell grid gap-10 xl:grid-cols-[0.85fr_1.15fr]">
      <div>
        <SectionHeading
          title="Frequently Asked Questions"
          description="Service-specific answers to help clients move forward with clarity."
          theme="light"
        />
      </div>
      <FAQAccordion items={service.faq} light />
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Related Projects"
        description="A few portfolio examples connected to this service category."
        align="center"
      />
      <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {
          relatedProjects.map((project) => (
            <a href={`/portfolio/${project.slug}`} class="group overflow-hidden rounded-[1.7rem] border border-champagne/18 bg-midnight">
              <img src={project.thumbnail.src} alt={project.title} class="h-64 w-full object-cover transition duration-500 group-hover:scale-105" loading="eager" />
              <div class="p-6">
                <h2 class="font-[var(--font-heading)] text-3xl text-ivory">{project.title}</h2>
                <p class="mt-2 text-sm text-white/62">{project.location}</p>
              </div>
            </a>
          ))
        }
      </div>
      <div class="mt-12 flex justify-center">
        <a href="/contact" class="button-gold rounded-xl px-6 py-4 text-[0.78rem]">Request an Estimate for This Service</a>
      </div>
    </div>
  </section>
</BaseLayout>
