---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import { generalFaqs, services } from "@/data/content";
import designInstallation from "@/assets/photos/design-installation.png";

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Services",
  description: "Ramirez Landscaping service categories including design, installation, maintenance, and irrigation.",
};
---

<BaseLayout title="Services | Ramirez Landscaping" description="Explore the full service categories offered by Ramirez Landscaping." schema={servicesSchema}>
  <PageHero
    title="Services"
    description="Outdoor environments planned, built, and cared for with precision."
    image={designInstallation}
    crumbs={[{ label: "Home", href: "/" }, { label: "Services" }]}
  />

  <section class="section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Complete Landscape Solutions"
        description="From inspired design to meticulous maintenance, Ramirez Landscaping delivers exceptional results that elevate the beauty, value, and enjoyment of your property."
        align="center"
      />
      <div class="mt-14 grid gap-6 xl:grid-cols-4">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="paper-panel section-pad">
    <div class="container-shell grid gap-8 rounded-[2rem] border border-black/8 bg-white p-8 shadow-[0_24px_42px_rgba(0,0,0,0.08)] xl:grid-cols-[1fr_0.9fr]">
      <div>
        <SectionHeading
          title="How We Work"
          description="Every engagement is rooted in careful listening, design clarity, and disciplined execution."
          theme="light"
        />
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <article class="rounded-[1.4rem] border border-black/8 bg-offwhite p-6">
            <h2 class="font-[var(--font-heading)] text-3xl text-midnight">Consultation & Discovery</h2>
            <p class="mt-3 text-sm leading-7 text-charcoal/78">
              We start by understanding your property, priorities, and the role the landscape
              should play in daily life.
            </p>
          </article>
          <article class="rounded-[1.4rem] border border-black/8 bg-offwhite p-6">
            <h2 class="font-[var(--font-heading)] text-3xl text-midnight">Tailored Scope</h2>
            <p class="mt-3 text-sm leading-7 text-charcoal/78">
              Service scope is tailored to the project rather than forcing every property into the
              same generic checklist.
            </p>
          </article>
          <article class="rounded-[1.4rem] border border-black/8 bg-offwhite p-6">
            <h2 class="font-[var(--font-heading)] text-3xl text-midnight">Disciplined Execution</h2>
            <p class="mt-3 text-sm leading-7 text-charcoal/78">
              Our crews focus on cleanliness, finish quality, communication, and a polished client
              experience on site.
            </p>
          </article>
          <article class="rounded-[1.4rem] border border-black/8 bg-offwhite p-6">
            <h2 class="font-[var(--font-heading)] text-3xl text-midnight">Long-Term Stewardship</h2>
            <p class="mt-3 text-sm leading-7 text-charcoal/78">
              We remain available for maintenance, seasonal adjustments, and phased improvements as
              needs evolve.
            </p>
          </article>
        </div>
      </div>
      <div class="rounded-[1.8rem] bg-[linear-gradient(180deg,#cfb66b,#b99333)] p-8 text-[#19140a]">
        <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-[#3d2d0f]/80">Request a Consultation</p>
        <h2 class="mt-3 font-[var(--font-display)] text-4xl leading-tight">Let’s bring your outdoor vision to life.</h2>
        <p class="mt-4 text-base leading-8 text-[#36280f]/80">
          Schedule a complimentary consultation to discuss design priorities, property needs, and a
          recommended path forward.
        </p>
        <a href="/contact" class="mt-8 inline-flex rounded-xl bg-midnight px-6 py-4 font-[var(--font-label)] text-[0.78rem] uppercase tracking-[0.18em] text-white">
          Request a Free Estimate
        </a>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Frequently Asked Questions"
        description="A few of the pre-sales questions clients often ask before moving forward."
        align="center"
      />
      <div class="mx-auto mt-12 max-w-5xl">
        <FAQAccordion items={generalFaqs.slice(0, 4)} />
      </div>
    </div>
  </section>
</BaseLayout>
