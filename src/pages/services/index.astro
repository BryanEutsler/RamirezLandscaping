---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import { generalFaqs, services } from "@/data/content";
import lawnMaintenance from "@/assets/photos/lawn-maintenance.png";

const servicesSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Yard Maintenance Services",
  description: "Basic yard maintenance services including mowing, edging, trimming, weeds, leaves, and cleanups.",
};
---

<BaseLayout title="Yard Maintenance Services | Ramirez Yard Maintenance" description="Explore mowing, edging, trimming, weed removal, leaf cleanup, and recurring yard service." schema={servicesSchema}>
  <PageHero
    title="Yard Maintenance Services"
    description="Basic, dependable yard care for lawns, edges, shrubs, weeds, leaves, and one-time cleanups."
    image={lawnMaintenance}
    crumbs={[{ label: "Home", href: "/" }, { label: "Services" }]}
  />

  <section class="section-pad">
    <div class="container-shell">
      <SectionHeading
        title="What We Do"
        description="Straightforward service for keeping a yard clean, cut, and under control."
        align="center"
      />
      <div class="mt-14 grid gap-6 xl:grid-cols-3">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <section class="paper-panel section-pad">
    <div class="container-shell grid gap-8 rounded-lg border border-black/8 bg-white p-8 shadow-[0_24px_42px_rgba(0,0,0,0.08)] xl:grid-cols-[1fr_0.9fr]">
      <div>
        <SectionHeading
          title="How We Work"
          description="A quick estimate, a clear scope, and a crew focused on leaving the yard tidy."
          theme="light"
        />
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          <article class="rounded-lg border border-black/8 bg-offwhite p-6">
            <h2 class="font-[var(--font-heading)] text-3xl text-midnight">Look at the Yard</h2>
            <p class="mt-3 text-sm leading-7 text-charcoal/78">
              We check size, access, growth, weeds, debris, and any problem areas before quoting.
            </p>
          </article>
          <article class="rounded-lg border border-black/8 bg-offwhite p-6">
            <h2 class="font-[var(--font-heading)] text-3xl text-midnight">Set the Scope</h2>
            <p class="mt-3 text-sm leading-7 text-charcoal/78">
              You choose recurring service, a one-time cleanup, or a smaller add-on like trimming.
            </p>
          </article>
          <article class="rounded-lg border border-black/8 bg-offwhite p-6">
            <h2 class="font-[var(--font-heading)] text-3xl text-midnight">Do the Work</h2>
            <p class="mt-3 text-sm leading-7 text-charcoal/78">
              We mow, edge, trim, clean up, and blow off hard surfaces before leaving.
            </p>
          </article>
          <article class="rounded-lg border border-black/8 bg-offwhite p-6">
            <h2 class="font-[var(--font-heading)] text-3xl text-midnight">Keep It Up</h2>
            <p class="mt-3 text-sm leading-7 text-charcoal/78">
              Weekly and biweekly routes keep the yard from turning into another big cleanup.
            </p>
          </article>
        </div>
      </div>
      <div class="rounded-lg bg-[linear-gradient(180deg,#cfb66b,#b99333)] p-8 text-[#19140a]">
        <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-[#3d2d0f]/80">Free Estimate</p>
        <h2 class="mt-3 font-[var(--font-display)] text-4xl leading-tight">Tell us what needs to be cut, cleaned, or kept up.</h2>
        <p class="mt-4 text-base leading-8 text-[#36280f]/80">
          Send a few details and we will recommend a simple service plan or one-time cleanup scope.
        </p>
        <a href="/contact" class="mt-8 inline-flex rounded-lg bg-midnight px-6 py-4 font-[var(--font-label)] text-[0.78rem] uppercase tracking-[0.18em] text-white">
          Request a Free Estimate
        </a>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-shell">
      <SectionHeading
        title="Frequently Asked Questions"
        description="Common questions about scheduling, pricing, and basic yard service."
        align="center"
      />
      <div class="mx-auto mt-12 max-w-5xl">
        <FAQAccordion items={generalFaqs.slice(0, 4)} />
      </div>
    </div>
  </section>
</BaseLayout>
