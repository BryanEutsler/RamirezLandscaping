---
import BaseLayout from "@/layouts/BaseLayout.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Terms of Service",
};
---

<BaseLayout title="Terms of Service | Ramirez Yard Maintenance" description="Terms of service for Ramirez Yard Maintenance." schema={schema}>
  <section class="paper-panel min-h-screen pt-36">
    <div class="container-shell max-w-4xl pb-20">
      <h1 class="font-[var(--font-display)] text-5xl text-midnight">Terms of Service</h1>
      <div class="rich-text mt-8 rounded-lg border border-black/8 bg-white p-8 shadow-[0_20px_36px_rgba(0,0,0,0.06)]">
        <p>
          This demo terms page provides a placeholder for the final service terms, website terms of
          use, and any language required by counsel or the client’s contracting process.
        </p>
        <p>
          Before launch, this page should be updated with the client’s approved legal copy,
          including any terms governing estimates, visit schedules, property access, green waste, and
          website use.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
