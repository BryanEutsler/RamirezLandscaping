---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import StarRating from "@/components/StarRating.astro";
import { testimonials } from "@/data/content";
import lawnMaintenance from "@/assets/photos/lawn-maintenance.png";

const testimonialSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Testimonials",
  description: "Client reviews for Ramirez Yard Maintenance.",
};
---

<BaseLayout title="Testimonials | Ramirez Yard Maintenance" description="Read reviews from yard maintenance customers." schema={testimonialSchema}>
  <PageHero
    title="Testimonials"
    description="Reviews from customers who needed reliable mowing, edging, trimming, and yard cleanups."
    image={lawnMaintenance}
    crumbs={[{ label: "Home", href: "/" }, { label: "Testimonials" }]}
  />

  <section class="section-pad">
    <div class="container-shell grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        testimonials.map((item) => (
          <article class="gold-frame rounded-lg bg-midnight p-7">
            <StarRating rating={item.rating} />
            <p class="mt-6 text-lg leading-8 text-ivory/92">“{item.quote}”</p>
            <div class="mt-8 border-t border-white/8 pt-5">
              <h2 class="font-[var(--font-heading)] text-3xl text-ivory">{item.name}</h2>
              <p class="mt-1 font-[var(--font-label)] text-xs uppercase tracking-[0.2em] text-white/55">
                {item.projectType}
              </p>
            </div>
          </article>
        ))
      }
    </div>
    <div class="container-shell mt-12">
      <div class="rounded-lg border border-champagne/18 bg-[linear-gradient(180deg,#113722,#0d2418)] p-8 md:p-10">
        <p class="font-[var(--font-label)] text-xs uppercase tracking-[0.24em] text-champagne/75">
          Third-Party Reviews
        </p>
        <h2 class="mt-3 font-[var(--font-display)] text-4xl text-ivory md:text-5xl">
          Want the yard handled too?
        </h2>
        <p class="mt-5 max-w-3xl text-base leading-8 text-white/72">
          Request a free estimate for routine service or a one-time cleanup and we will recommend a
          simple next step.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
